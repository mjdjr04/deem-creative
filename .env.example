# Supabase configuration — copy this file to ".env.local" and fill in your values.
# Find these in your Supabase project: Settings → API.
# The anon key is safe to expose publicly (Row Level Security protects writes).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Cloudflare Turnstile site key (public) — bot check on the contact + booking
# forms. Get it at Cloudflare → Turnstile → Add site. Leave blank to disable.
# The matching SECRET goes in the booking Apps Script's Script Properties
# (key: TURNSTILE_SECRET), never here.
VITE_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
